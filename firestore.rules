rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 3. Entity Validation Blueprints
    function isValidTransaction(data, userId) {
      return data.keys().hasAll([
          'userId', 'type', 'category', 'amount', 'date', 'monthKey',
          'account', 'title', 'encryptedPayload', 'isEncrypted'
        ])
        && data.userId is string && data.userId == request.auth.uid && data.userId == userId
        && data.type is string && (data.type == 'income' || data.type == 'expense')
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 64
        && (data.amount is int || data.amount is float) && data.amount >= 0 && data.amount <= 1000000000000
        && data.date is string && data.date.size() == 10
        && data.monthKey is string && data.monthKey.size() == 7
        && data.account is string && data.account.size() >= 1 && data.account.size() <= 64
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.encryptedPayload is string && data.encryptedPayload.size() <= 4096
        && data.isEncrypted is bool;
    }

    function isValidSavingGoal(data, userId) {
      return data.keys().hasAll([
          'userId', 'name', 'category', 'targetAmount', 'currentAmount',
          'monthlyContribution', 'targetDate', 'encryptedPayload', 'isEncrypted'
        ])
        && data.userId is string && data.userId == request.auth.uid && data.userId == userId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 64
        && (data.targetAmount is int || data.targetAmount is float) && data.targetAmount >= 0 && data.targetAmount <= 1000000000000
        && (data.currentAmount is int || data.currentAmount is float) && data.currentAmount >= 0 && data.currentAmount <= 1000000000000
        && (data.monthlyContribution is int || data.monthlyContribution is float) && data.monthlyContribution >= 0 && data.monthlyContribution <= 1000000000000
        && data.targetDate is string && data.targetDate.size() == 10
        && data.encryptedPayload is string && data.encryptedPayload.size() <= 4096
        && data.isEncrypted is bool;
    }

    function isValidBudgetLimit(data, userId) {
      return data.keys().hasAll([
          'userId', 'category', 'monthKey', 'limitAmount', 'alertThreshold',
          'notifyEnabled', 'encryptedPayload', 'isEncrypted'
        ])
        && data.userId is string && data.userId == request.auth.uid && data.userId == userId
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 64
        && data.monthKey is string && data.monthKey.size() == 7
        && (data.limitAmount is int || data.limitAmount is float) && data.limitAmount >= 0 && data.limitAmount <= 1000000000000
        && (data.alertThreshold is int || data.alertThreshold is float) && data.alertThreshold >= 1 && data.alertThreshold <= 100
        && data.notifyEnabled is bool
        && data.encryptedPayload is string && data.encryptedPayload.size() <= 4096
        && data.isEncrypted is bool;
    }

    function isValidFinancialPlan(data, userId) {
      return data.keys().hasAll([
          'userId', 'title', 'category', 'estimatedCost', 'allocatedAmount',
          'targetMonth', 'priority', 'status', 'encryptedPayload', 'isEncrypted'
        ])
        && data.userId is string && data.userId == request.auth.uid && data.userId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 64
        && (data.estimatedCost is int || data.estimatedCost is float) && data.estimatedCost >= 0 && data.estimatedCost <= 1000000000000
        && (data.allocatedAmount is int || data.allocatedAmount is float) && data.allocatedAmount >= 0 && data.allocatedAmount <= 1000000000000
        && data.targetMonth is string && data.targetMonth.size() >= 7 && data.targetMonth.size() <= 10
        && data.priority is string && (data.priority == 'high' || data.priority == 'medium' || data.priority == 'low')
        && data.status is string && (data.status == 'planned' || data.status == 'ready' || data.status == 'completed')
        && data.encryptedPayload is string && data.encryptedPayload.size() <= 4096
        && data.isEncrypted is bool;
    }

    // 4. Collection Match Blocks
    match /users/{userId}/transactions/{transactionId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(transactionId)
        && isValidTransaction(incoming(), userId);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/savings/{savingId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(savingId)
        && isValidSavingGoal(incoming(), userId);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/budgets/{budgetId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(budgetId)
        && isValidBudgetLimit(incoming(), userId);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/plans/{planId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(planId)
        && isValidFinancialPlan(incoming(), userId);
      allow delete: if isOwner(userId);
    }
  }
}
